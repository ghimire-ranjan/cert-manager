# Local settings for the AI agent and MCP. Copy this file to .env and fill in the keys.
# .env is ignored by git: it holds secrets and must never be committed or shared.
# CAP loads .env automatically when you run `cds watch`.
#
# TO SWITCH MODEL: keep exactly ONE "model block" below active (no # in front of its
# cds.requires.llm lines) and put # in front of the others. Then restart `cds watch`.
# Check what is active with:  cds env requires.llm

# ===================== Model block 1: Groq (free tier) ========== ACTIVE
cds.requires.llm.kind=openai
cds.requires.llm.model=openai/gpt-oss-120b
cds.requires.llm.credentials.baseURL=https://api.groq.com/openai/v1

# ===================== Model block 2: SAP AI Core (company) ===== off
# Replace the model with a cheaper one from AI Launchpad > Generative AI Hub > Model Library.
#cds.requires.llm.kind=aicore
#cds.requires.llm.model=anthropic--claude-4.6-sonnet

# ===================== Model block 3: fake model (no AI, free) == off
#cds.requires.llm.kind=llm-mock

# ===================== Keys (secrets) =====================
# Groq: console.groq.com > API Keys (starts with gsk_)
OPENAI_API_KEY=

# SAP AI Core service key as ONE line of JSON:
# BTP cockpit > subaccount > Instances > SAP AI Core instance > Service Keys > View.
AICORE_SERVICE_KEY=
