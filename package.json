              "roles": [
                "admin"
              ]
            },
            "dan": {
              "password": "dan",
              "roles": [
                "employee"
              ]
            },
            "ranjan": {
              "password": "ranjan",
              "roles": [
                "employee"
              ]
            },
            "erik": {
              "password": "erik",
              "roles": [
                "employee"
              ]
            },
            "alice": false,
