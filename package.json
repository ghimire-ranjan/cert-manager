{
  "name": "cert-manager",
  "version": "1.0.0",
  "type": "commonjs",
  "dependencies": {
    "@cap-js/agents": "^0.9.8",
    "@cap-js/hana": "^3",
    "@cap-js/mcp": "^1.5.0",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10.1.0",
    "cds-plugin-ui5": "^0.13.0"
