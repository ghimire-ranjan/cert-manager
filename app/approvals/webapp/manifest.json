{
  "_version": "1.85.0",
  "sap.app": {
    "id": "approvals",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.25.0",
      "toolsId": "3bf690ae-11d6-44d3-acca-d123a98dd144"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/admin/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "approvals-display": {
          "semanticObject": "approvals",
          "action": "display",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "approvals.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "EmployeeCertificationsList",
          "target": "EmployeeCertificationsList"
        },
        {
          "pattern": "EmployeeCertifications({key}):?query:",
          "name": "EmployeeCertificationsObjectPage",
          "target": "EmployeeCertificationsObjectPage"
        }
      ],
      "targets": {
        "EmployeeCertificationsList": {
          "type": "Component",
          "id": "EmployeeCertificationsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/EmployeeCertifications",
              "variantManagement": "Page",
              "views": {
                "paths": [
                  {
                    "key": "all",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#All"
                  },
                  {
                    "key": "pending",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#Pending"
                  },
                  {
                    "key": "verified",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#Verified"
                  },
                  {
                    "key": "rejected",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#Rejected"
                  }
                ],
                "showCounts": true
              },
              "navigation": {
                "EmployeeCertifications": {
                  "detail": {
                    "route": "EmployeeCertificationsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "EmployeeCertificationsObjectPage": {
          "type": "Component",
          "id": "EmployeeCertificationsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/EmployeeCertifications"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "certmanager.service"
  }
}
